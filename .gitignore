# ==========================================
# Git Ignore Configuration - AegisThreat
# Phishing URL Detection System
# ==========================================

# --- Environment & Secret Variables ---
# Never commit active credentials, API keys, or environment files
.env
.env.*
!.env.example
*.env
backend/.env
frontend/.env
frontend/.env.local

# --- Databases & Persistent Local Storage ---
# SQLite local databases generated at runtime
*.db
*.sqlite
*.sqlite3
scans.db
backend/scans.db

# --- Python & Bytecode ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Virtual Environments ---
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# --- Testing & Code Coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
.mypy_cache/
.ruff_cache/

# --- Node.js & Frontend Artifacts ---
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Operating System & Editor Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor Settings
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.bak

# --- Logs ---
*.log
logs/
