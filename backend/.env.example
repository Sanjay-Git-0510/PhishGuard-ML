# ==============================================================
# AegisThreat - Environment Configuration Template (.env.example)
# Copy this file to .env before starting the backend application:
#   copy .env.example .env (Windows) or cp .env.example .env (Linux/macOS)
# ==============================================================

# Environment Mode: development / production / staging
ENVIRONMENT=development

# Application Identification
PROJECT_NAME="AegisThreat - Phishing URL Detection System"

# Database Connection URL:
# - SQLite (default for quick local development & testing):
DATABASE_URL=sqlite:///./scans.db
# - PostgreSQL (recommended for production/containerized deployments):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aegis_threat_db

# Allowed CORS Origins (JSON array of allowed frontend URLs)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000","http://localhost:8080"]

